#!/usr/bin/env python3
"""
CSV Tool - Unix-style commands for CSV files
Usage:
    csv head [-N|+N] [-a] [file]
    csv tail [-N|+N] [-a] [file]
    csv wc [-l] [-w] [-c] [file]
    csv cut [-a] [-f <file>] field1 field2 ...
    csv pick [-f <file>] row1 row2 ...
    
When no filename is given (or '-' is used), reads from stdin.

For head:
    -N  Show first N data rows (default: 10)
    +N  Show all but the last N data rows

For tail:
    -N  Show last N data rows (default: 10)
    +N  Start from row N and print to end (1-indexed, like POSIX tail)

For pick:
    Select specific data rows by number (1-indexed)
    Header is always preserved in output

Examples:
    csv head -5 myfile.csv              # First 5 data rows
    csv head +3 myfile.csv              # All but last 3 data rows
    csv tail -5 myfile.csv              # Last 5 data rows
    csv tail +3 myfile.csv              # Skip first 2 data rows, print rest
    csv head -5 -a myfile.csv           # First 5 rows with header
    cat myfile.csv | csv head -1        # First row from stdin
    csv cut -f myfile.csv name age      # Select 'name' and 'age' columns
    csv cut -a -f myfile.csv name age   # Same, with header
    cat data.csv | csv cut name age     # Select columns from stdin
    csv pick -f data.csv 1 3 5          # Select rows 1, 3, and 5
    cat data.csv | csv pick 2 4         # Select rows 2 and 4 from stdin
"""

VERSION = "1.2.0"

import csv
import sys
from pathlib import Path
from io import StringIO


def get_input_source(filename):
    """Get input source - either file or stdin."""
    if filename is None or filename == '-':
        # Read all of stdin into memory
        content = sys.stdin.read()
        return StringIO(content)
    else:
        try:
            return open(filename, 'r', newline='', encoding='utf-8')
        except FileNotFoundError:
            print(f"csv: {filename}: No such file or directory", file=sys.stderr)
            sys.exit(1)
        except IsADirectoryError:
            print(f"csv: {filename}: Is a directory", file=sys.stderr)
            sys.exit(1)
        except PermissionError:
            print(f"csv: {filename}: Permission denied", file=sys.stderr)
            sys.exit(1)


def read_csv_rows(filename):
    """Read all rows from a CSV file or stdin.
    
    Returns (comment_lines, rows) where comment_lines are lines starting with #
    at the very beginning of the file, and rows are the parsed CSV rows.
    """
    source = get_input_source(filename)
    try:
        # First, read all lines to extract leading comments
        content = source.read()
        lines = content.splitlines(keepends=True)
        
        comment_lines = []
        data_start = 0
        
        # Extract leading comment lines
        for i, line in enumerate(lines):
            if line.lstrip().startswith('#'):
                comment_lines.append(line.rstrip('\r\n'))
                data_start = i + 1
            else:
                break
        
        # Parse remaining content as CSV
        remaining_content = ''.join(lines[data_start:])
        rows = []
        reader = csv.reader(remaining_content.splitlines())
        for row in reader:
            rows.append(row)
        
        return comment_lines, rows
    finally:
        if filename is not None and filename != '-':
            source.close()


def write_csv_rows(rows, comment_lines=None):
    """Write CSV rows to stdout, optionally with leading comment lines."""
    if comment_lines:
        for line in comment_lines:
            print(line)
    writer = csv.writer(sys.stdout)
    for row in rows:
        writer.writerow(row)


def csv_head(filename, n, with_header=False, from_start=False):
    """Show the first n rows of a CSV file (with header only if with_header is True).
    
    If from_start is True (triggered by +N), show all but the last N rows.
    """
    comment_lines, rows = read_csv_rows(filename)
    
    if not rows:
        return
    
    if from_start:
        # +N means show all but the last N data rows
        if with_header:
            if len(rows) <= 1:
                write_csv_rows(rows, comment_lines)
            else:
                header = [rows[0]]
                data_rows = rows[1:]
                if n < len(data_rows):
                    data_rows = data_rows[:-n]
                else:
                    data_rows = []
                write_csv_rows(header + data_rows, comment_lines)
        else:
            if len(rows) > 1:
                data_rows = rows[1:]
                if n < len(data_rows):
                    data_rows = data_rows[:-n]
                else:
                    data_rows = []
                write_csv_rows(data_rows)
    else:
        # Normal behavior: show first N rows
        if with_header:
            # Include comments, header (first row), plus first n data rows
            if len(rows) <= 1:
                write_csv_rows(rows, comment_lines)
            else:
                header = [rows[0]]
                data_rows = rows[1:n+1]
                write_csv_rows(header + data_rows, comment_lines)
        else:
            # Skip header, just show first n data rows
            if len(rows) > 1:
                data_rows = rows[1:n+1]
                write_csv_rows(data_rows)


def csv_tail(filename, n, with_header=False, from_start=False):
    """Show the last n rows of a CSV file (with header only if with_header is True).
    
    If from_start is True (triggered by +N), start from row N and print to end.
    Row numbering starts at 1, so +1 means all rows, +2 skips first data row, etc.
    """
    comment_lines, rows = read_csv_rows(filename)
    
    if not rows:
        return
    
    if from_start:
        # +N means start from row N (1-indexed) and print to end
        # +1 = all data rows, +2 = skip first data row, etc.
        start_idx = n - 1  # Convert to 0-indexed
        if with_header:
            if len(rows) <= 1:
                write_csv_rows(rows, comment_lines)
            else:
                header = [rows[0]]
                data_rows = rows[1:]
                if start_idx < len(data_rows):
                    data_rows = data_rows[start_idx:]
                else:
                    data_rows = []
                write_csv_rows(header + data_rows, comment_lines)
        else:
            if len(rows) > 1:
                data_rows = rows[1:]
                if start_idx < len(data_rows):
                    data_rows = data_rows[start_idx:]
                else:
                    data_rows = []
                write_csv_rows(data_rows)
    else:
        # Normal behavior: show last N rows
        if with_header:
            # Include comments, header (first row), plus last n data rows
            if len(rows) <= 1:
                write_csv_rows(rows, comment_lines)
            else:
                header = [rows[0]]
                data_rows = rows[-n:] if n < len(rows) else rows[1:]
                write_csv_rows(header + data_rows, comment_lines)
        else:
            # Skip header, just show last n data rows
            data_rows = rows[-n:] if len(rows) > 1 and n < len(rows) else rows[1:]
            write_csv_rows(data_rows)


def csv_wc(filename, show_rows=True, show_columns=True, show_bytes=True, with_header=False):
    """Count bytes, columns, and rows in a CSV file (like wc for CSV).
    
    By default, counts only data rows (excludes header). Use with_header=True
    to include the header in the row count.
    """
    # Handle stdin vs file differently for byte count
    if filename is None or filename == '-':
        content = sys.stdin.read()
        file_size = len(content.encode('utf-8'))
        source = StringIO(content)
        display_name = '-'
    else:
        try:
            file_size = Path(filename).stat().st_size
            source = open(filename, 'r', newline='', encoding='utf-8')
        except FileNotFoundError:
            print(f"csv: {filename}: No such file or directory", file=sys.stderr)
            sys.exit(1)
        except IsADirectoryError:
            print(f"csv: {filename}: Is a directory", file=sys.stderr)
            sys.exit(1)
        except PermissionError:
            print(f"csv: {filename}: Permission denied", file=sys.stderr)
            sys.exit(1)
        display_name = filename
    
    try:
        # Read and parse CSV
        content = source.read()
        lines = content.splitlines(keepends=True)
        
        # Skip leading comment lines
        data_start = 0
        for i, line in enumerate(lines):
            if line.lstrip().startswith('#'):
                data_start = i + 1
            else:
                break
        
        remaining_content = ''.join(lines[data_start:])
        rows = list(csv.reader(remaining_content.splitlines()))
        
        # Count columns from header (first row)
        num_columns = len(rows[0]) if rows else 0
        
        # Count rows (excluding header by default)
        if with_header:
            num_rows = len(rows)
        else:
            num_rows = len(rows) - 1 if rows else 0
        
        # Build output
        output_parts = []
        if show_rows:
            output_parts.append(f"{num_rows:8d}")
        if show_columns:
            output_parts.append(f"{num_columns:8d}")
        if show_bytes:
            output_parts.append(f"{file_size:8d}")
        
        print(f"{''.join(output_parts)} {display_name}")
    finally:
        if filename is not None and filename != '-':
            source.close()


def csv_cut(filename, field_names, with_header=False):
    """Select specific fields from a CSV file by name."""
    comment_lines, rows = read_csv_rows(filename)
    
    if not rows:
        return
    
    # Get header and find column indices
    header = rows[0]
    indices = []
    for name in field_names:
        try:
            indices.append(header.index(name))
        except ValueError:
            print(f"csv cut: unknown field: {name}", file=sys.stderr)
            print(f"Available fields: {', '.join(header)}", file=sys.stderr)
            sys.exit(1)
    
    # Output comment lines first (as part of header) only if -a flag
    if with_header and comment_lines:
        for line in comment_lines:
            print(line)
    
    # Output header with selected fields only if -a flag
    writer = csv.writer(sys.stdout)
    if with_header:
        writer.writerow([header[i] for i in indices])
    
    # Output each data row with selected fields
    for row in rows[1:]:
        selected = []
        for i in indices:
            if i < len(row):
                selected.append(row[i])
            else:
                selected.append('')  # Handle rows with fewer columns
        writer.writerow(selected)


def csv_pick(filename, row_numbers):
    """Select specific data rows by number (1-indexed).
    
    Header is always preserved in output.
    """
    comment_lines, rows = read_csv_rows(filename)
    
    if not rows:
        return
    
    data_count = len(rows) - 1  # Exclude header
    
    # Output comments and header (always preserved)
    if comment_lines:
        for line in comment_lines:
            print(line)
    
    writer = csv.writer(sys.stdout)
    writer.writerow(rows[0])  # Header
    
    # Output selected data rows
    for row_num in row_numbers:
        if row_num < 1:
            print(f"csv pick: invalid row number: {row_num}", file=sys.stderr)
            continue
        if row_num > data_count:
            print(f"csv pick: row {row_num} out of range (have {data_count} data rows)", file=sys.stderr)
            continue
        writer.writerow(rows[row_num])  # row_num maps directly since header is rows[0]


def parse_wc_options(args):
    """Parse wc options and return (show_rows, show_columns, show_bytes, remaining_args)."""
    show_rows = False
    show_columns = False
    show_bytes = False
    remaining = []
    
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ['-a', '--add-header']:
            # Pass through to be handled later
            remaining.append(arg)
        elif arg.startswith('-') and arg != '-':
            # Process option characters
            for char in arg[1:]:
                if char == 'l':
                    show_rows = True
                elif char == 'w':
                    show_columns = True
                elif char == 'c':
                    show_bytes = True
                elif char == 'a':
                    # Pass through -a combined with other options
                    remaining.append('-a')
                else:
                    print(f"csv wc: invalid option -- '{char}'", file=sys.stderr)
                    sys.exit(1)
        else:
            remaining.append(arg)
        i += 1
    
    # If no options specified, show all
    if not show_rows and not show_columns and not show_bytes:
        show_rows = show_columns = show_bytes = True
    
    return show_rows, show_columns, show_bytes, remaining


def parse_file_option(args):
    """Parse -f <file> option and return (filename, remaining_args)."""
    filename = None
    remaining = []
    
    i = 0
    while i < len(args):
        if args[i] == '-f' and i + 1 < len(args):
            filename = args[i + 1]
            i += 2
        elif args[i].startswith('-f') and len(args[i]) > 2:
            # Handle -ffilename (no space)
            filename = args[i][2:]
            i += 1
        else:
            remaining.append(args[i])
            i += 1
    
    return filename, remaining


def main():
    if len(sys.argv) < 2:
        print("usage: csv {head,tail,wc,cut,pick} [options] [file|fields...]", file=sys.stderr)
        print("\nCommands:", file=sys.stderr)
        print("  head    Show first n rows of CSV file", file=sys.stderr)
        print("  tail    Show last n rows of CSV file", file=sys.stderr)
        print("  wc      Count rows, columns, and bytes", file=sys.stderr)
        print("  cut     Select specific fields from CSV", file=sys.stderr)
        print("  pick    Select specific rows by number", file=sys.stderr)
        print("\nUse 'csv <command> --help' for more information on a command.", file=sys.stderr)
        print("\nWhen no file is specified, reads from stdin. Use '-' for explicit stdin.", file=sys.stderr)
        sys.exit(1)
    
    command = sys.argv[1]
    args = sys.argv[2:]
    
    # Check for version
    if command in ['-V', '--version']:
        print(f"csv {VERSION}")
        sys.exit(0)
    
    # Check for help
    if command in ['-h', '--help'] or '--help' in args:
        print("usage: csv {head,tail,wc,cut,pick} [options] [file|fields...]")
        print("\nCSV utility - Unix-style commands for CSV files")
        print(f"Version {VERSION}")
        print("\nCommands:")
        print("  head    Show first n rows")
        print("  tail    Show last n rows")
        print("  wc      Count rows, columns, and bytes")
        print("  cut     Select specific fields")
        print("  pick    Select specific rows by number")
        print("\nFor head/tail:")
        print("  csv head [-N] [-a] [file]    Show first N data rows (default: 10)")
        print("  csv head [+N] [-a] [file]    Show all but last N data rows")
        print("  csv tail [-N] [-a] [file]    Show last N data rows (default: 10)")
        print("  csv tail [+N] [-a] [file]    Start from row N and print to end (1-indexed)")
        print("  -a, --add-header  Include header row (and comments) in output")
        print("\nFor wc:")
        print("  csv wc [-l] [-w] [-c] [-a] [file]")
        print("  -l                Count rows only")
        print("  -w                Count columns only")
        print("  -c                Count bytes only")
        print("  -a, --add-header  Include header in row count")
        print("  (default: show all three counts, exclude header from row count)")
        print("\nFor cut:")
        print("  csv cut [-a] [-f <file>] field1 field2 ...")
        print("  -a, --add-header  Include header row (and comments) in output")
        print("  -f <file>         Specify input file (default: stdin)")
        print("  Selects and outputs specified fields from the CSV")
        print("\nFor pick:")
        print("  csv pick [-f <file>] row1 row2 ...")
        print("  -f <file>         Specify input file (default: stdin)")
        print("  Selects specific data rows by number (1-indexed)")
        print("  Header is always preserved in output")
        sys.exit(0)
    
    if command == 'head':
        # Parse head arguments
        n = 10  # default
        with_header = False
        from_start = False
        filename = None
        
        # Parse arguments - filename is the non-option argument
        for arg in args:
            if arg == '-a' or arg == '--add-header':
                with_header = True
            elif arg.startswith('+') and len(arg) > 1 and arg[1:].isdigit():
                # +N means all but last N rows
                n = int(arg[1:])
                from_start = True
            elif arg.startswith('-') and len(arg) > 1 and arg[1:].isdigit():
                n = int(arg[1:])
                from_start = False
            elif arg == '-':
                filename = '-'
            elif not arg.startswith('-'):
                filename = arg
        
        csv_head(filename, n, with_header, from_start)
    
    elif command == 'tail':
        # Parse tail arguments
        n = 10  # default
        with_header = False
        from_start = False
        filename = None
        
        # Parse arguments - filename is the non-option argument
        for arg in args:
            if arg == '-a' or arg == '--add-header':
                with_header = True
            elif arg.startswith('+') and len(arg) > 1 and arg[1:].isdigit():
                # +N means start from row N (1-indexed)
                n = int(arg[1:])
                from_start = True
            elif arg.startswith('-') and len(arg) > 1 and arg[1:].isdigit():
                n = int(arg[1:])
                from_start = False
            elif arg == '-':
                filename = '-'
            elif not arg.startswith('-'):
                filename = arg
        
        csv_tail(filename, n, with_header, from_start)
    
    elif command == 'wc':
        # Parse wc options
        show_rows, show_columns, show_bytes, remaining = parse_wc_options(args)
        
        # Check for -a flag and filename
        with_header = False
        filename = None
        for arg in remaining:
            if arg == '-a' or arg == '--add-header':
                with_header = True
            elif arg == '-':
                filename = '-'
            elif not arg.startswith('-'):
                filename = arg
        
        csv_wc(filename, show_rows, show_columns, show_bytes, with_header)
    
    elif command == 'cut':
        # Parse cut arguments
        filename, remaining = parse_file_option(args)
        
        # Check for -a flag
        with_header = False
        field_names = []
        for arg in remaining:
            if arg == '-a' or arg == '--add-header':
                with_header = True
            else:
                field_names.append(arg)
        
        if not field_names:
            print("csv cut: no fields specified", file=sys.stderr)
            print("usage: csv cut [-a] [-f <file>] field1 field2 ...", file=sys.stderr)
            sys.exit(1)
        
        csv_cut(filename, field_names, with_header)
    
    elif command == 'pick':
        # Parse pick arguments
        filename, remaining = parse_file_option(args)
        
        # Parse row numbers
        row_numbers = []
        for arg in remaining:
            if arg.isdigit():
                row_numbers.append(int(arg))
            elif arg.startswith('-') and arg != '-':
                print(f"csv pick: invalid option -- '{arg}'", file=sys.stderr)
                sys.exit(1)
            else:
                print(f"csv pick: invalid row number: {arg}", file=sys.stderr)
                sys.exit(1)
        
        if not row_numbers:
            print("csv pick: no row numbers specified", file=sys.stderr)
            print("usage: csv pick [-f <file>] row1 row2 ...", file=sys.stderr)
            sys.exit(1)
        
        csv_pick(filename, row_numbers)
    
    else:
        print(f"csv: unknown command '{command}'", file=sys.stderr)
        print("usage: csv {head,tail,wc,cut,pick} [options] [file|fields...]", file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
