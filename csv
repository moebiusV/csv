#!/usr/bin/env python3
"""
CSV Tool - Unix-style commands for CSV files
Usage:
    csv head [-N|+N] [-a] [file]
    csv tail [-N|+N] [-a] [file]
    csv wc [-l] [-w] [-c] [file]
    csv cut [-a] [-x] [-f <file>] field1 field2 ...
    csv pick [-a] [-f <file>] row1 row2 ...
    csv grep [-a] [-v] [-f <file>] regex [field ...]
    csv sort [-a] [-n] [-r] [-f <file>] [field ...]
    
When no filename is given (or '-' is used), reads from stdin.

For head:
    -N  Show first N data rows (default: 10)
    +N  Show all but the last N data rows

For tail:
    -N  Show last N data rows (default: 10)
    +N  Start from row N and print to end (1-indexed, like POSIX tail)

For pick:
    Select specific data rows by number (1-indexed)

For grep:
    Select rows where field matches regex pattern
    -v  Invert match (select non-matching rows)
    If no field specified, searches all fields

For sort:
    Sort rows by one or more fields
    -n  Numeric sort (instead of alphabetical)
    -r  Reverse (descending) order
    If no field specified, sorts by all fields in order

Examples:
    csv head -5 myfile.csv              # First 5 data rows
    csv head +3 myfile.csv              # All but last 3 data rows
    csv tail -5 myfile.csv              # Last 5 data rows
    csv tail +3 myfile.csv              # Skip first 2 data rows, print rest
    csv head -5 -a myfile.csv           # First 5 rows with header
    cat myfile.csv | csv head -1        # First row from stdin
    csv cut -f myfile.csv name age      # Select 'name' and 'age' columns
    csv cut -a -f myfile.csv name age   # Same, with header
    csv cut -x -f myfile.csv age        # All columns except 'age'
    cat data.csv | csv cut name age     # Select columns from stdin
    csv pick -f data.csv 1 3 5          # Select rows 1, 3, and 5
    csv pick -a -f data.csv 1 3 5       # Same, with header
    cat data.csv | csv pick 2 4         # Select rows 2 and 4 from stdin
    csv grep -f data.csv "^A" name      # Rows where name starts with A
    csv grep -a -f data.csv "NYC" city  # Same, with header
    csv grep -v -f data.csv "test" name # Rows where name doesn't match test
    csv grep -f data.csv "error"        # Search all fields for "error"
    csv grep -f data.csv "A" name city  # Search name and city fields
    csv sort -f data.csv name           # Sort alphabetically by name
    csv sort -n -f data.csv age         # Sort numerically by age
    csv sort -a -r -f data.csv age      # Sort descending with header
    csv sort -f data.csv city name      # Sort by city, then by name
    csv sort -f data.csv                # Sort by all fields in order
"""

VERSION = "1.2.0"

import csv
import sys
from pathlib import Path
from io import StringIO


def get_input_source(filename):
    """Get input source - either file or stdin."""
    if filename is None or filename == '-':
        # Read all of stdin into memory
        content = sys.stdin.read()
        return StringIO(content)
    else:
        try:
            return open(filename, 'r', newline='', encoding='utf-8')
        except FileNotFoundError:
            print(f"csv: {filename}: No such file or directory", file=sys.stderr)
            sys.exit(1)
        except IsADirectoryError:
            print(f"csv: {filename}: Is a directory", file=sys.stderr)
            sys.exit(1)
        except PermissionError:
            print(f"csv: {filename}: Permission denied", file=sys.stderr)
            sys.exit(1)


def read_csv_rows(filename):
    """Read all rows from a CSV file or stdin.
    
    Returns (comment_lines, rows) where comment_lines are lines starting with #
    at the very beginning of the file, and rows are the parsed CSV rows.
    """
    source = get_input_source(filename)
    try:
        # First, read all lines to extract leading comments
        content = source.read()
        lines = content.splitlines(keepends=True)
        
        comment_lines = []
        data_start = 0
        
        # Extract leading comment lines
        for i, line in enumerate(lines):
            if line.lstrip().startswith('#'):
                comment_lines.append(line.rstrip('\r\n'))
                data_start = i + 1
            else:
                break
        
        # Parse remaining content as CSV
        remaining_content = ''.join(lines[data_start:])
        rows = []
        reader = csv.reader(remaining_content.splitlines())
        for row in reader:
            rows.append(row)
        
        return comment_lines, rows
    finally:
        if filename is not None and filename != '-':
            source.close()


def write_csv_rows(rows, comment_lines=None):
    """Write CSV rows to stdout, optionally with leading comment lines."""
    if comment_lines:
        for line in comment_lines:
            print(line)
    writer = csv.writer(sys.stdout)
    for row in rows:
        writer.writerow(row)


def csv_head(filename, n, with_header=False, from_start=False):
    """Show the first n rows of a CSV file (with header only if with_header is True).
    
    If from_start is True (triggered by +N), show all but the last N rows.
    """
    comment_lines, rows = read_csv_rows(filename)
    
    if not rows:
        return
    
    if from_start:
        # +N means show all but the last N data rows
        if with_header:
            if len(rows) <= 1:
                write_csv_rows(rows, comment_lines)
            else:
                header = [rows[0]]
                data_rows = rows[1:]
                if n < len(data_rows):
                    data_rows = data_rows[:-n]
                else:
                    data_rows = []
                write_csv_rows(header + data_rows, comment_lines)
        else:
            if len(rows) > 1:
                data_rows = rows[1:]
                if n < len(data_rows):
                    data_rows = data_rows[:-n]
                else:
                    data_rows = []
                write_csv_rows(data_rows)
    else:
        # Normal behavior: show first N rows
        if with_header:
            # Include comments, header (first row), plus first n data rows
            if len(rows) <= 1:
                write_csv_rows(rows, comment_lines)
            else:
                header = [rows[0]]
                data_rows = rows[1:n+1]
                write_csv_rows(header + data_rows, comment_lines)
        else:
            # Skip header, just show first n data rows
            if len(rows) > 1:
                data_rows = rows[1:n+1]
                write_csv_rows(data_rows)


def csv_tail(filename, n, with_header=False, from_start=False):
    """Show the last n rows of a CSV file (with header only if with_header is True).
    
    If from_start is True (triggered by +N), start from row N and print to end.
    Row numbering starts at 1, so +1 means all rows, +2 skips first data row, etc.
    """
    comment_lines, rows = read_csv_rows(filename)
    
    if not rows:
        return
    
    if from_start:
        # +N means start from row N (1-indexed) and print to end
        # +1 = all data rows, +2 = skip first data row, etc.
        start_idx = n - 1  # Convert to 0-indexed
        if with_header:
            if len(rows) <= 1:
                write_csv_rows(rows, comment_lines)
            else:
                header = [rows[0]]
                data_rows = rows[1:]
                if start_idx < len(data_rows):
                    data_rows = data_rows[start_idx:]
                else:
                    data_rows = []
                write_csv_rows(header + data_rows, comment_lines)
        else:
            if len(rows) > 1:
                data_rows = rows[1:]
                if start_idx < len(data_rows):
                    data_rows = data_rows[start_idx:]
                else:
                    data_rows = []
                write_csv_rows(data_rows)
    else:
        # Normal behavior: show last N rows
        if with_header:
            # Include comments, header (first row), plus last n data rows
            if len(rows) <= 1:
                write_csv_rows(rows, comment_lines)
            else:
                header = [rows[0]]
                data_rows = rows[-n:] if n < len(rows) else rows[1:]
                write_csv_rows(header + data_rows, comment_lines)
        else:
            # Skip header, just show last n data rows
            data_rows = rows[-n:] if len(rows) > 1 and n < len(rows) else rows[1:]
            write_csv_rows(data_rows)


def csv_wc(filename, show_rows=True, show_columns=True, show_bytes=True, with_header=False):
    """Count bytes, columns, and rows in a CSV file (like wc for CSV).
    
    By default, counts only data rows (excludes header and comments). 
    Use with_header=True to include the header and comment lines in the row count.
    """
    # Handle stdin vs file differently for byte count
    if filename is None or filename == '-':
        content = sys.stdin.read()
        file_size = len(content.encode('utf-8'))
        source = StringIO(content)
        display_name = '-'
    else:
        try:
            file_size = Path(filename).stat().st_size
            source = open(filename, 'r', newline='', encoding='utf-8')
        except FileNotFoundError:
            print(f"csv: {filename}: No such file or directory", file=sys.stderr)
            sys.exit(1)
        except IsADirectoryError:
            print(f"csv: {filename}: Is a directory", file=sys.stderr)
            sys.exit(1)
        except PermissionError:
            print(f"csv: {filename}: Permission denied", file=sys.stderr)
            sys.exit(1)
        display_name = filename
    
    try:
        # Read and parse CSV
        content = source.read()
        lines = content.splitlines(keepends=True)
        
        # Count and skip leading comment lines
        comment_count = 0
        data_start = 0
        for i, line in enumerate(lines):
            if line.lstrip().startswith('#'):
                comment_count += 1
                data_start = i + 1
            else:
                break
        
        remaining_content = ''.join(lines[data_start:])
        rows = list(csv.reader(remaining_content.splitlines()))
        
        # Count columns from header (first row)
        num_columns = len(rows[0]) if rows else 0
        
        # Count rows
        if with_header:
            # Include comment lines + header + data rows
            num_rows = comment_count + len(rows)
        else:
            # Data rows only (exclude comments and header)
            num_rows = len(rows) - 1 if rows else 0
        
        # Build output
        output_parts = []
        if show_rows:
            output_parts.append(f"Rows: {num_rows}")
        if show_columns:
            output_parts.append(f"Columns: {num_columns}")
        if show_bytes:
            output_parts.append(f"Bytes: {file_size}")
        
        print("  ".join(output_parts))
    finally:
        if filename is not None and filename != '-':
            source.close()


def csv_cut(filename, field_names, with_header=False, exclude=False):
    """Select specific fields from a CSV file by name.
    
    If exclude=True, select all fields EXCEPT the specified ones.
    """
    comment_lines, rows = read_csv_rows(filename)
    
    if not rows:
        return
    
    # Get header and find column indices
    header = rows[0]
    
    if exclude:
        # Find indices of fields to EXCLUDE, then use the rest
        exclude_indices = set()
        for name in field_names:
            try:
                exclude_indices.add(header.index(name))
            except ValueError:
                print(f"csv cut: unknown field: {name}", file=sys.stderr)
                print(f"Available fields: {', '.join(header)}", file=sys.stderr)
                sys.exit(1)
        indices = [i for i in range(len(header)) if i not in exclude_indices]
    else:
        # Find indices of fields to INCLUDE
        indices = []
        for name in field_names:
            try:
                indices.append(header.index(name))
            except ValueError:
                print(f"csv cut: unknown field: {name}", file=sys.stderr)
                print(f"Available fields: {', '.join(header)}", file=sys.stderr)
                sys.exit(1)
    
    # Output comment lines first (as part of header) only if -a flag
    if with_header and comment_lines:
        for line in comment_lines:
            print(line)
    
    # Output header with selected fields only if -a flag
    writer = csv.writer(sys.stdout)
    if with_header:
        writer.writerow([header[i] for i in indices])
    
    # Output each data row with selected fields
    for row in rows[1:]:
        selected = []
        for i in indices:
            if i < len(row):
                selected.append(row[i])
            else:
                selected.append('')  # Handle rows with fewer columns
        writer.writerow(selected)


def csv_pick(filename, row_numbers, with_header=False):
    """Select specific data rows by number (1-indexed).
    
    By default, outputs only the selected data rows. Use with_header=True
    to include the header row (and any comment lines) in output.
    """
    comment_lines, rows = read_csv_rows(filename)
    
    if not rows:
        return
    
    data_count = len(rows) - 1  # Exclude header
    
    # Output comments and header only if -a flag
    if with_header:
        if comment_lines:
            for line in comment_lines:
                print(line)
        writer = csv.writer(sys.stdout)
        writer.writerow(rows[0])  # Header
    else:
        writer = csv.writer(sys.stdout)
    
    # Output selected data rows
    for row_num in row_numbers:
        if row_num < 1:
            print(f"csv pick: invalid row number: {row_num}", file=sys.stderr)
            continue
        if row_num > data_count:
            print(f"csv pick: row {row_num} out of range (have {data_count} data rows)", file=sys.stderr)
            continue
        writer.writerow(rows[row_num])  # row_num maps directly since header is rows[0]


def csv_grep(filename, pattern, field_names=None, with_header=False, invert=False):
    """Select rows where a field matches a regex pattern.
    
    By default, outputs only matching data rows. Use with_header=True
    to include the header row (and any comment lines) in output.
    Use invert=True to select non-matching rows.
    If field_names is None or empty, search all fields.
    """
    import re
    
    try:
        regex = re.compile(pattern)
    except re.error as e:
        print(f"csv grep: invalid regex '{pattern}': {e}", file=sys.stderr)
        sys.exit(1)
    
    comment_lines, rows = read_csv_rows(filename)
    
    if not rows:
        return
    
    header = rows[0]
    
    # Find field indices (or use all if none specified)
    if field_names:
        indices = []
        for name in field_names:
            try:
                indices.append(header.index(name))
            except ValueError:
                print(f"csv grep: unknown field: {name}", file=sys.stderr)
                print(f"Available fields: {', '.join(header)}", file=sys.stderr)
                sys.exit(1)
    else:
        # Search all fields
        indices = list(range(len(header)))
    
    # Output comments and header only if -a flag
    if with_header:
        if comment_lines:
            for line in comment_lines:
                print(line)
        writer = csv.writer(sys.stdout)
        writer.writerow(header)
    else:
        writer = csv.writer(sys.stdout)
    
    # Output matching data rows
    for row in rows[1:]:
        match_found = False
        for idx in indices:
            field_value = row[idx] if idx < len(row) else ''
            if regex.search(field_value):
                match_found = True
                break
        if (match_found and not invert) or (not match_found and invert):
            writer.writerow(row)


def csv_sort(filename, field_names=None, with_header=False, numeric=False, reverse=False):
    """Sort rows by one or more fields.
    
    By default, sorts alphabetically. Use numeric=True for numeric sort.
    Use reverse=True for descending order.
    If field_names is None or empty, sort by all fields in order.
    """
    comment_lines, rows = read_csv_rows(filename)
    
    if not rows:
        return
    
    header = rows[0]
    
    # Find field indices (or use all if none specified)
    if field_names:
        indices = []
        for name in field_names:
            try:
                indices.append(header.index(name))
            except ValueError:
                print(f"csv sort: unknown field: {name}", file=sys.stderr)
                print(f"Available fields: {', '.join(header)}", file=sys.stderr)
                sys.exit(1)
    else:
        # Sort by all fields in order
        indices = list(range(len(header)))
    
    # Create sort key function
    def sort_key(row):
        values = []
        for idx in indices:
            val = row[idx] if idx < len(row) else ''
            if numeric:
                try:
                    # Try to parse as float for numeric comparison
                    val = float(val) if val else 0.0
                except ValueError:
                    val = 0.0
            values.append(val)
        return values
    
    # Sort data rows (exclude header)
    data_rows = rows[1:]
    sorted_rows = sorted(data_rows, key=sort_key, reverse=reverse)
    
    # Output comments and header only if -a flag
    if with_header:
        if comment_lines:
            for line in comment_lines:
                print(line)
        writer = csv.writer(sys.stdout)
        writer.writerow(header)
    else:
        writer = csv.writer(sys.stdout)
    
    # Output sorted rows
    for row in sorted_rows:
        writer.writerow(row)


def parse_wc_options(args):
    """Parse wc options and return (show_rows, show_columns, show_bytes, remaining_args)."""
    show_rows = False
    show_columns = False
    show_bytes = False
    remaining = []
    
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ['-a', '--add-header']:
            # Pass through to be handled later
            remaining.append(arg)
        elif arg.startswith('-') and arg != '-':
            # Process option characters
            for char in arg[1:]:
                if char == 'l':
                    show_rows = True
                elif char == 'w':
                    show_columns = True
                elif char == 'c':
                    show_bytes = True
                elif char == 'a':
                    # Pass through -a combined with other options
                    remaining.append('-a')
                else:
                    print(f"csv wc: invalid option -- '{char}'", file=sys.stderr)
                    sys.exit(1)
        else:
            remaining.append(arg)
        i += 1
    
    # If no options specified, show all
    if not show_rows and not show_columns and not show_bytes:
        show_rows = show_columns = show_bytes = True
    
    return show_rows, show_columns, show_bytes, remaining


def parse_file_option(args):
    """Parse -f <file> option and return (filename, remaining_args)."""
    filename = None
    remaining = []
    
    i = 0
    while i < len(args):
        if args[i] == '-f' and i + 1 < len(args):
            filename = args[i + 1]
            i += 2
        elif args[i].startswith('-f') and len(args[i]) > 2:
            # Handle -ffilename (no space)
            filename = args[i][2:]
            i += 1
        else:
            remaining.append(args[i])
            i += 1
    
    return filename, remaining


def main():
    if len(sys.argv) < 2:
        print("usage: csv {head,tail,wc,cut,pick,grep,sort} [options] [file|fields...]", file=sys.stderr)
        print("\nCommands:", file=sys.stderr)
        print("  head    Show first n rows of CSV file", file=sys.stderr)
        print("  tail    Show last n rows of CSV file", file=sys.stderr)
        print("  wc      Count rows, columns, and bytes", file=sys.stderr)
        print("  cut     Select specific fields from CSV", file=sys.stderr)
        print("  pick    Select specific rows by number", file=sys.stderr)
        print("  grep    Select rows matching a regex", file=sys.stderr)
        print("  sort    Sort rows by field values", file=sys.stderr)
        print("\nUse 'csv <command> --help' for more information on a command.", file=sys.stderr)
        print("\nWhen no file is specified, reads from stdin. Use '-' for explicit stdin.", file=sys.stderr)
        sys.exit(1)
    
    command = sys.argv[1]
    args = sys.argv[2:]
    
    # Check for version
    if command in ['-V', '--version']:
        print(f"csv {VERSION}")
        sys.exit(0)
    
    # Check for help
    if command in ['-h', '--help'] or '--help' in args:
        print("usage: csv {head,tail,wc,cut,pick,grep,sort} [options] [file|fields...]")
        print("\nCSV utility - Unix-style commands for CSV files")
        print(f"Version {VERSION}")
        print("\nCommands:")
        print("  head    Show first n rows")
        print("  tail    Show last n rows")
        print("  wc      Count rows, columns, and bytes")
        print("  cut     Select specific fields")
        print("  pick    Select specific rows by number")
        print("  grep    Select rows matching a regex")
        print("  sort    Sort rows by field values")
        print("\nFor head/tail:")
        print("  csv head [-N] [-a] [file]    Show first N data rows (default: 10)")
        print("  csv head [+N] [-a] [file]    Show all but last N data rows")
        print("  csv tail [-N] [-a] [file]    Show last N data rows (default: 10)")
        print("  csv tail [+N] [-a] [file]    Start from row N and print to end (1-indexed)")
        print("  -a, --add-header  Include header row (and comments) in output")
        print("\nFor wc:")
        print("  csv wc [-l] [-w] [-c] [-a] [file]")
        print("  -l                Count rows only")
        print("  -w                Count columns only")
        print("  -c                Count bytes only")
        print("  -a, --add-header  Include header (and comments) in row count")
        print("  (default: show all three counts, exclude header from row count)")
        print("\nFor cut:")
        print("  csv cut [-a] [-x] [-f <file>] field1 field2 ...")
        print("  -a, --add-header  Include header row (and comments) in output")
        print("  -x, --exclude     Exclude specified fields instead of selecting them")
        print("  -f <file>         Specify input file (default: stdin)")
        print("  Selects and outputs specified fields from the CSV")
        print("\nFor pick:")
        print("  csv pick [-a] [-f <file>] row1 row2 ...")
        print("  -a, --add-header  Include header row (and comments) in output")
        print("  -f <file>         Specify input file (default: stdin)")
        print("  Selects specific data rows by number (1-indexed)")
        print("\nFor grep:")
        print("  csv grep [-a] [-v] [-f <file>] regex [field ...]")
        print("  -a, --add-header  Include header row (and comments) in output")
        print("  -v, --invert      Select non-matching rows")
        print("  -f <file>         Specify input file (default: stdin)")
        print("  Selects rows where field(s) match the regex pattern")
        print("  If no field specified, searches all fields")
        print("\nFor sort:")
        print("  csv sort [-a] [-n] [-r] [-f <file>] [field ...]")
        print("  -a, --add-header  Include header row (and comments) in output")
        print("  -n, --numeric     Sort numerically instead of alphabetically")
        print("  -r, --reverse     Sort in descending order")
        print("  -f <file>         Specify input file (default: stdin)")
        print("  Sorts rows by the specified field(s)")
        print("  If no field specified, sorts by all fields in order")
        sys.exit(0)
    
    if command == 'head':
        # Parse head arguments
        n = 10  # default
        with_header = False
        from_start = False
        filename = None
        
        # Parse arguments - filename is the non-option argument
        for arg in args:
            if arg == '-a' or arg == '--add-header':
                with_header = True
            elif arg.startswith('+') and len(arg) > 1 and arg[1:].isdigit():
                # +N means all but last N rows
                n = int(arg[1:])
                from_start = True
            elif arg.startswith('-') and len(arg) > 1 and arg[1:].isdigit():
                n = int(arg[1:])
                from_start = False
            elif arg == '-':
                filename = '-'
            elif not arg.startswith('-'):
                filename = arg
        
        csv_head(filename, n, with_header, from_start)
    
    elif command == 'tail':
        # Parse tail arguments
        n = 10  # default
        with_header = False
        from_start = False
        filename = None
        
        # Parse arguments - filename is the non-option argument
        for arg in args:
            if arg == '-a' or arg == '--add-header':
                with_header = True
            elif arg.startswith('+') and len(arg) > 1 and arg[1:].isdigit():
                # +N means start from row N (1-indexed)
                n = int(arg[1:])
                from_start = True
            elif arg.startswith('-') and len(arg) > 1 and arg[1:].isdigit():
                n = int(arg[1:])
                from_start = False
            elif arg == '-':
                filename = '-'
            elif not arg.startswith('-'):
                filename = arg
        
        csv_tail(filename, n, with_header, from_start)
    
    elif command == 'wc':
        # Parse wc options
        show_rows, show_columns, show_bytes, remaining = parse_wc_options(args)
        
        # Check for -a flag and filename
        with_header = False
        filename = None
        for arg in remaining:
            if arg == '-a' or arg == '--add-header':
                with_header = True
            elif arg == '-':
                filename = '-'
            elif not arg.startswith('-'):
                filename = arg
        
        csv_wc(filename, show_rows, show_columns, show_bytes, with_header)
    
    elif command == 'cut':
        # Parse cut arguments
        filename, remaining = parse_file_option(args)
        
        # Check for -a and -x flags
        with_header = False
        exclude = False
        field_names = []
        for arg in remaining:
            if arg == '-a' or arg == '--add-header':
                with_header = True
            elif arg == '-x' or arg == '--exclude':
                exclude = True
            elif arg.startswith('-') and arg != '-':
                print(f"csv cut: invalid option -- '{arg}'", file=sys.stderr)
                sys.exit(1)
            else:
                field_names.append(arg)
        
        if not field_names:
            print("csv cut: no fields specified", file=sys.stderr)
            print("usage: csv cut [-a] [-x] [-f <file>] field1 field2 ...", file=sys.stderr)
            sys.exit(1)
        
        csv_cut(filename, field_names, with_header, exclude)
    
    elif command == 'pick':
        # Parse pick arguments
        filename, remaining = parse_file_option(args)
        
        # Check for -a flag and parse row numbers
        with_header = False
        row_numbers = []
        for arg in remaining:
            if arg == '-a' or arg == '--add-header':
                with_header = True
            elif arg.isdigit():
                row_numbers.append(int(arg))
            elif arg.startswith('-') and arg != '-':
                print(f"csv pick: invalid option -- '{arg}'", file=sys.stderr)
                sys.exit(1)
            else:
                print(f"csv pick: invalid row number: {arg}", file=sys.stderr)
                sys.exit(1)
        
        if not row_numbers:
            print("csv pick: no row numbers specified", file=sys.stderr)
            print("usage: csv pick [-a] [-f <file>] row1 row2 ...", file=sys.stderr)
            sys.exit(1)
        
        csv_pick(filename, row_numbers, with_header)
    
    elif command == 'grep':
        # Parse grep arguments
        filename, remaining = parse_file_option(args)
        
        # Check for -a and -v flags, then get regex and field(s)
        with_header = False
        invert = False
        positional = []
        for arg in remaining:
            if arg == '-a' or arg == '--add-header':
                with_header = True
            elif arg == '-v' or arg == '--invert':
                invert = True
            elif arg.startswith('-') and arg != '-':
                print(f"csv grep: invalid option -- '{arg}'", file=sys.stderr)
                sys.exit(1)
            else:
                positional.append(arg)
        
        if len(positional) < 1:
            print("csv grep: requires regex pattern", file=sys.stderr)
            print("usage: csv grep [-a] [-v] [-f <file>] regex [field ...]", file=sys.stderr)
            sys.exit(1)
        
        pattern = positional[0]
        field_names = positional[1:] if len(positional) > 1 else None
        
        csv_grep(filename, pattern, field_names, with_header, invert)
    
    elif command == 'sort':
        # Parse sort arguments
        filename, remaining = parse_file_option(args)
        
        # Check for flags and get field names
        with_header = False
        numeric = False
        reverse = False
        field_names = []
        for arg in remaining:
            if arg == '-a' or arg == '--add-header':
                with_header = True
            elif arg == '-n' or arg == '--numeric':
                numeric = True
            elif arg == '-r' or arg == '--reverse':
                reverse = True
            elif arg.startswith('-') and arg != '-':
                print(f"csv sort: invalid option -- '{arg}'", file=sys.stderr)
                sys.exit(1)
            else:
                field_names.append(arg)
        
        # None means sort by all fields
        csv_sort(filename, field_names if field_names else None, with_header, numeric, reverse)
    
    else:
        print(f"csv: unknown command '{command}'", file=sys.stderr)
        print("usage: csv {head,tail,wc,cut,pick,grep,sort} [options] [file|fields...]", file=sys.stderr)
        sys.exit(1)


